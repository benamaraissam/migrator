# Hugging Face (recommended if no OpenAI key)
HF_TOKEN=hf_your_token_here
LLM_MODEL=meta-llama/Llama-3.2-3B-Instruct

# Or OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Or custom OpenAI-compatible endpoint
# LLM_BASE_URL=https://your-endpoint.com/v1
# LLM_API_KEY=your_key
# LLM_MODEL=your-model

# Optional
PORT=3001

# Max token budget for prompt (default 8192). Increase for models with larger context windows.
# LLM_MAX_TOKENS=8192

# Set to 1 if your LLM doesn't support response_format: json_object
# LLM_NO_JSON_MODE=1
